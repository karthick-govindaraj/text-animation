{
  "_readme": "Kinetic Text Studio — Scene Premium JSON v2. Paste this schema to an AI with your content brief. The AI should return an importable project JSON using the same top-level shape, excluding _readme, _schema, and _ai_instructions.",
  "_schema": {
    "version": {
      "type": "number",
      "required": true,
      "value": 2
    },
    "schema": {
