            "comic-pop",
            "luxury-title",
            "tech-hud"
          ]
        },
        "broll": {
          "description": "Image-only scene B-roll. Provide exactly 3 ranked candidates when possible. The app tries rank 1 first, then rank 2 and rank 3 if loading or CORS export validation fails.",
          "fields": {
            "enabled": { "type": "boolean" },
            "query": { "type": "string" },
            "purpose": { "type": "string" },
            "selectedAssetId": { "type": "string" },
            "fallbackMode": { "type": "string", "validValues": ["try-next-provider"] },
            "assets": {
              "type": "array of 3 image candidates",
              "fields": {
                "id": { "type": "string" },
                "rank": { "type": "number", "validValues": [1, 2, 3] },
                "source": { "type": "string", "examples": ["Pexels", "Unsplash", "Pixabay"] },
                "title": { "type": "string" },
                "imageUrl": { "type": "direct image URL" },
                "pageUrl": { "type": "source page URL" },
                "license": { "type": "string" },
                "creator": { "type": "string" },
                "width": { "type": "number" },
                "height": { "type": "number" },
                "relevanceScore": { "type": "number", "range": "0 to 1" }
              }
            },
            "fit": { "type": "string", "validValues": ["cover", "contain", "stretch"] },
            "opacity": { "type": "number", "range": "0 to 1" },
            "darken": { "type": "number", "range": "0 to 1" },
            "blur": { "type": "number", "range": "0 to 40" },
            "vignette": { "type": "number", "range": "0 to 1" }
          }
        },
        "camera": {
          "description": "Simple scene-level Ken Burns camera motion.",
          "fields": {
            "enabled": { "type": "boolean" },
            "zoomFrom": { "type": "number" },
            "zoomTo": { "type": "number" },
            "panXFrom": { "type": "number", "range": "-1 to 1" },
            "panXTo": { "type": "number", "range": "-1 to 1" },
            "panYFrom": { "type": "number", "range": "-1 to 1" },
            "panYTo": { "type": "number", "range": "-1 to 1" },
            "easing": { "type": "string", "validValues": ["linear", "easeInOut", "easeOutCubic"] }
          }
        },
        "transitionIn": {
          "fields": {
            "type": { "type": "string", "validValues": ["none", "fade", "zoom", "slide", "blur", "flash"] },
            "duration": { "type": "number", "range": "0 to 3" },
            "direction": { "type": "string", "validValues": ["left", "right", "up", "down"] }
          }
        },
        "transitionOut": {
          "fields": {
            "type": { "type": "string", "validValues": ["none", "fade", "zoom", "slide", "blur", "flash"] },
            "duration": { "type": "number", "range": "0 to 3" },
            "direction": { "type": "string", "validValues": ["left", "right", "up", "down"] }
          }
        },
        "graphics": {
          "description": "Simple scene-local graphic overlays, timed in seconds relative to the scene.",
          "fields": {
            "type": { "type": "string", "validValues": ["arrow", "circle", "underline", "stat-card", "warning-label", "quote-card"] },
            "start": { "type": "number" },
            "end": { "type": "number" },
            "x": { "type": "number", "range": "0 to 1" },
            "y": { "type": "number", "range": "0 to 1" },
            "text": { "type": "string" },
            "value": { "type": "string" },
            "color": { "type": "hex colour string" },
            "animation": { "type": "string", "validValues": ["fade", "pop", "slide", "draw"] }
          }
        }
      }
    }
