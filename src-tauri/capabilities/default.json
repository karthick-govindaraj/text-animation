{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-appcache-write-recursive",
    "fs:allow-appcache-read-recursive",
    "fs:allow-remove",
    "shell:default",
    "opener:default"
  ]
}
